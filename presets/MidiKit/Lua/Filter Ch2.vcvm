  "data": {
    "script": "--[[\n@target stoermelder MIDI-KIT\n@engine Lua\n@author stoermelder\n@description Drops all incoming MIDI messages except for MIDI channel 2\n--]]\n\nfunction processMidi(midiPort, msg)\n    if midi.getChannel(msg) == 2 then\n        midiOut.send(msg)\n    end\nend"
  }
