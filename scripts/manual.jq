# Rewrites the manualUrl/changelogUrl entries of plugin.json from the repository's Markdown files
# to the VCV Library manual pages generated by plugin-manual.mk. Only URLs starting with $github
# (the repository's file URL prefix) are changed.
#   jq --arg github <blob url> --arg library https://library.vcvrack.com/<plugin slug> -f manual.jq plugin.json

def isrepo: type == "string" and startswith($github);

(if (.manualUrl | isrepo) then .manualUrl = $library + "#manual" else . end)
| (if (.changelogUrl | isrepo) then .changelogUrl = $library + "/changelog" else . end)
| .modules |= map(if (.manualUrl | isrepo) then .manualUrl = $library + "/" + .slug + "#manual" else . end)
