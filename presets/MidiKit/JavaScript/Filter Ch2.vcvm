  "data": {
    "script": "/**\n * @target stoermelder MIDI-KIT\n * @engine Elk\n * @author stoermelder\n * @description Drops all incoming MIDI messages except for MIDI channel 2\n */\n\nlet processMidi = function(midiPort, msg) {\n    if (midi.getChannel(msg) === 2) {\n        midiOut.send(msg);\n    }\n};"
  }
}