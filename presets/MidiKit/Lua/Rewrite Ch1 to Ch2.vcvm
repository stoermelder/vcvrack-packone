{
  "plugin": "Stoermelder-P1",
  "model": "MidiKit",
  "version": "2.0.0",
  "params": [
    {
      "value": 0.0,
      "id": 0
    },
    {
      "value": 0.0,
      "id": 1
    },
    {
      "value": 0.0,
      "id": 2
    },
    {
      "value": 0.0,
      "id": 3
    }
  ],
  "data": {
    "script": "--[[\n@target stoermelder MIDI-KIT\n@engine Lua\n@author stoermelder\n@description Rewrites all MIDI messages on channel 1 to channel 2\n--]]\n\nfunction processMidi(midiInput, msg)\n    if midi.getChannel(msg) == 1 then\n        midi.setChannel(msg, 2)\n    end\n    midiOut.send(1, msg)\nend"
  }
}